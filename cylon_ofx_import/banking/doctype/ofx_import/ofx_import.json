   "read_only": 1,
   "in_list_view": 1
  },
  {
   "fieldname": "ofx_file",
   "fieldtype": "Attach",
   "label": "OFX File",
   "reqd": 1,
   "description": "OFX 1.0.x SGML or 2.0 XML file exported from your bank. Supports Nedbank, FNB, ABSA, Standard Bank, Investec."
  },
  {
   "fieldname": "section_metadata",
   "fieldtype": "Section Break",
   "label": "OFX Metadata",
   "collapsible": 1
  },
