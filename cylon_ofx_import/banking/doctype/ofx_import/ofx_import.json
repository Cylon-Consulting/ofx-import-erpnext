  },
  {
   "fieldname": "bank_account",
   "fieldtype": "Link",
   "label": "Bank Account",
   "options": "Bank Account",
   "reqd": 1,
   "in_list_view": 1,
   "description": "Target Bank Account. Must belong to the selected Company and have is_company_account = 1."
  },
  {
   "fieldname": "column_break_setup",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "status",
