   "fieldname": "ofx_acctid",
   "fieldtype": "Data",
   "label": "OFX ACCTID",
   "read_only": 1,
   "description": "Account number as encoded in the OFX file."
  },
  {
   "fieldname": "ofx_bankid",
   "fieldtype": "Data",
   "label": "OFX BANKID",
   "read_only": 1,
   "description": "Diagnostic only. SA banks do not use standard routing numbers here (e.g. Nedbank sends NETBANK, Standard sends 00000001)."
  },
  {
   "fieldname": "ofx_fi_org",
   "fieldtype": "Data",
   "label": "OFX FI / ORG",
   "read_only": 1,
   "description": "Financial institution identifier (only Investec of the four confirmed SA banks emits this)."
  },
  {
   "fieldname": "column_break_metadata",
   "fieldtype": "Column Break"
  },
  {
   "fieldname": "ofx_period_start",
   "fieldtype": "Date",
   "label": "Statement Period Start",
   "read_only": 1
  },
  {
   "fieldname": "ofx_period_end",
   "fieldtype": "Date",
   "label": "Statement Period End",
   "read_only": 1
  },
  {
   "fieldname": "ofx_currency",
   "fieldtype": "Link",
   "label": "OFX Currency",
   "options": "Currency",
   "read_only": 1
  },
  {
   "fieldname": "ofx_opening_balance",
   "fieldtype": "Currency",
   "label": "Opening Balance",
   "read_only": 1,
   "options": "ofx_currency",
   "description": "Derived as closing balance minus the net of non-zero STMTTRN amounts. Copy into the Bank Reconciliation Tool's Account Opening Balance field (which ERPNext normally derives from GL; this figure reflects the bank's own position at period start)."
  },
  {
   "fieldname": "ofx_closing_balance",
   "fieldtype": "Currency",
   "label": "Closing Balance",
   "read_only": 1,
   "options": "ofx_currency",
   "description": "From the OFX LEDGERBAL/BALAMT tag. Copy into the Bank Reconciliation Tool's Closing Balance as per Bank Statement field."
  },
  {
   "fieldname": "ofx_closing_balance_date",
   "fieldtype": "Date",
   "label": "Closing Balance As Of",
   "read_only": 1,
   "description": "LEDGERBAL/DTASOF. Typically the statement end date."
